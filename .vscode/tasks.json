{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "g++ SDLblit.cpp -o blit $(sdl2-config --cflags --libs)",
      "problemMatcher": []
    },
    {
      "label": "run",
      "type": "shell",
      "command": "./blit",
      "problemMatcher": []
    },
    {
      "label": "build & run",
      "dependsOrder": "sequence", // Use "parallel" to run them at the same time
      "dependsOn": [
        "build",
        "run"
      ],
      "problemMatcher": []
    }
  ]
}